            "schema": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]{1,120}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response; examples are abbreviated.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "commandId": "your-command-id"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Invalid/expired token"
          },
          "403": {
            "description": "Scope or access denied"
          },
          "404": {
            "description": "Resource not on this account"
          },
          "409": {
            "description": "State conflict"
          },
          "422": {
            "description": "Trading rule rejection"
          },
          "429": {
            "description": "Rate limit"
          },
          "503": {
            "description": "Service unavailable; reconcile uncertain writes"
          }
        }
      },
      "get": {
        "operationId": "orders",
        "tags": [
          "Trade"
        ],
        "summary": "Order history",
        "description": "Up to 500 recent orders, newest first. Bounded recent history; no cursor pagination or full-history guarantee.",
        "security": [
