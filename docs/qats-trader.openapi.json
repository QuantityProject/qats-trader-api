{
  "openapi": "3.0.3",
  "info": {
    "title": "QATS Trader API",
    "version": "1.0.0",
    "description": "Trader-only REST reference. No payments, payouts, administration or provider credentials. Bearer authentication, not Binance/Bybit wire compatibility. Some response examples are abbreviated."
  },
  "servers": [
    {
      "url": "https://prop.qats.us/api/v1",
      "description": "QATS. Use a token created in your QATS account settings; simulation is determined by account and feed"
    },
    {
      "url": "https://dev.prop.qats.us/api/v1",
      "description": "QATS DEV, for testing with a token created on DEV"
    }
  ],
  "components": {
    "securitySchemes": {
      "TradingToken": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "qats_trade_<64 hex>"
      }
    }
  },
  "paths": {
    "/trading/account": {
      "get": {
        "operationId": "account",
        "tags": [
          "Account"
        ],
        "summary": "Account & risk",
        "description": "Balance, equity, accepted rules, trading access and risk summary. Read the accepted account rules; do not hard-code challenge targets or capacity. This response example is abbreviated.",
        "security": [
          {
            "TradingToken": []
          }
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Successful response; examples are abbreviated.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "account": {
                    "id": "QEV-example",
                    "status": "active"
                  },
                  "rules": {
                    "allowedSymbols": [
                      "BTCUSDT"
                    ]
                  },
                  "counts": {
                    "positions": 0,
                    "workingOrders": 0,
                    "executions": 0
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Invalid/expired token"
          },
          "403": {
            "description": "Scope or access denied"
          },
          "404": {
            "description": "Resource not on this account"
          },
          "409": {
            "description": "State conflict"
          },
          "422": {
            "description": "Trading rule rejection"
          },
          "429": {
            "description": "Rate limit"
          },
          "503": {
            "description": "Service unavailable; reconcile uncertain writes"
          }
        }
      }
    },
    "/trading/state": {
      "get": {
        "operationId": "state",
        "tags": [
          "Account"
        ],
        "summary": "Account state",
        "description": "Account, positions and orders in one response. ",
        "security": [
          {
            "TradingToken": []
          }
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Successful response; examples are abbreviated.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "account": {
                    "id": "QEV-example"
                  },
                  "positions": [],
                  "orders": []
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Invalid/expired token"
          },
          "403": {
            "description": "Scope or access denied"
          },
          "404": {
            "description": "Resource not on this account"
          },
          "409": {
            "description": "State conflict"
          },
          "422": {
            "description": "Trading rule rejection"
          },
          "429": {
            "description": "Rate limit"
          },
          "503": {
            "description": "Service unavailable; reconcile uncertain writes"
          }
        }
      }
    },
    "/trading/market": {
      "get": {
        "operationId": "market",
        "tags": [
          "Market data"
        ],
        "summary": "Ticker & order book",
        "description": "The authoritative quote, book and funding data for your account. Book sizes use QATS lots. Order/position quantity uses base-asset units. Inspect source and simulated; a simulated quote is not an exchange fill.",
        "security": [
          {
            "TradingToken": []
          }
        ],
        "parameters": [
          {
            "name": "symbol",
            "in": "query",
            "required": true,
            "description": "Allowed perpetual symbol, e.g. BTCUSDT; see rules.allowedSymbols.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response; examples are abbreviated.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "snapshot": {
                    "symbol": "BTCUSDT",
                    "last": 65000,
                    "bid": 64999.9,
                    "ask": 65000.1,
                    "tickSize": 0.1,
                    "source": "qats-server-simulation",
                    "simulated": true
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Invalid/expired token"
          },
          "403": {
            "description": "Scope or access denied"
          },
          "404": {
            "description": "Resource not on this account"
          },
          "409": {
            "description": "State conflict"
          },
          "422": {
            "description": "Trading rule rejection"
          },
          "429": {
            "description": "Rate limit"
          },
          "503": {
            "description": "Service unavailable; reconcile uncertain writes"
          }
        }
      }
    },
    "/trading/bars": {
      "get": {
        "operationId": "bars",
        "tags": [
          "Market data"
        ],
        "summary": "Candlesticks",
        "description": "Candles from the account’s venue and price path. Availability depends on the configured feed and instrument history.",
        "security": [
          {
            "TradingToken": []
          }
        ],
        "parameters": [
          {
            "name": "symbol",
            "in": "query",
            "required": true,
            "description": "Allowed perpetual symbol, e.g. BTCUSDT; see rules.allowedSymbols.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "interval",
            "in": "query",
            "required": false,
            "description": "1, 5, 15, 60, 240 or D.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Requested bar count, subject to server bounds.",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response; examples are abbreviated.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Invalid/expired token"
          },
          "403": {
            "description": "Scope or access denied"
          },
          "404": {
            "description": "Resource not on this account"
          },
          "409": {
            "description": "State conflict"
          },
          "422": {
            "description": "Trading rule rejection"
          },
          "429": {
            "description": "Rate limit"
          },
          "503": {
            "description": "Service unavailable; reconcile uncertain writes"
          }
        }
      }
    },
    "/trading/stream": {
      "get": {
        "operationId": "stream",
        "tags": [
          "Market data"
        ],
        "summary": "Market stream (SSE)",
        "description": "Subscribe to market events over streaming HTTP. Content-Type: text/event-stream. Quote frames, plus an account frame scoped to the token’s own account. Not WebSocket and not a private order/fill stream. Use an HTTP client that supports the Authorization header. Reconnect with backoff and refresh state.",
        "security": [
          {
            "TradingToken": []
          }
        ],
        "parameters": [
          {
            "name": "symbol",
            "in": "query",
            "required": true,
            "description": "Allowed perpetual symbol, e.g. BTCUSDT; see rules.allowedSymbols.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response; examples are abbreviated.",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Invalid/expired token"
          },
          "403": {
            "description": "Scope or access denied"
          },
          "404": {
            "description": "Resource not on this account"
          },
          "409": {
            "description": "State conflict"
          },
          "422": {
            "description": "Trading rule rejection"
          },
          "429": {
            "description": "Rate limit"
          },
          "503": {
            "description": "Service unavailable; reconcile uncertain writes"
          }
        }
      }
    },
    "/trading/orders": {
      "post": {
        "operationId": "place_order",
        "tags": [
          "Trade"
        ],
        "summary": "Place order",
        "description": "Submit an order through the same risk checks and execution engine as the terminal. 201: immediate fill. 202: resting order. Example price is illustrative; check quotes, precision and capacity before submitting.",
        "security": [
          {
            "TradingToken": []
          }
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "description": "Your own unique command ID. Required on every write; a write without one is refused.",
            "schema": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]{1,120}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response; examples are abbreviated.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "commandId": "your-command-id",
                  "order": {
                    "id": "ord_example",
                    "status": "working",
                    "quantity": 0.001
                  }
                }
              }
            }
          },
          "201": {
            "description": "Immediate execution"
          },
          "202": {
            "description": "Resting order accepted"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Invalid/expired token"
          },
          "403": {
            "description": "Scope or access denied"
          },
          "404": {
            "description": "Resource not on this account"
          },
          "409": {
            "description": "State conflict"
          },
          "422": {
            "description": "Trading rule rejection"
          },
          "429": {
            "description": "Rate limit"
          },
          "503": {
            "description": "Service unavailable; reconcile uncertain writes"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "symbol": {
                    "type": "string",
                    "description": "Allowed perpetual symbol, e.g. BTCUSDT; see rules.allowedSymbols."
                  },
                  "side": {
                    "type": "string",
                    "description": "BUY or SELL."
                  },
                  "type": {
                    "type": "string",
                    "description": "MARKET, LIMIT, STOP_MARKET or STOP_LIMIT."
                  },
                  "quantity": {
                    "type": "number",
                    "description": "Base-asset units, matching the instrument step. Use quantity or lots, not both."
                  },
                  "lots": {
                    "type": "number",
                    "description": "Alternative QATS-lot sizing; required if quantity is omitted."
                  },
                  "price": {
                    "type": "number",
                    "description": "Limit price or stop trigger, required for non-market orders."
                  },
                  "limitPrice": {
                    "type": "number",
                    "description": "Execution limit for STOP_LIMIT."
                  },
                  "timeInForce": {
                    "type": "string",
                    "description": "GTC, IOC or POST_ONLY, subject to order/plan restrictions."
                  },
                  "reduceOnly": {
                    "type": "boolean",
                    "description": "Only reduce exposure; cannot open or reverse."
                  },
                  "bracket": {
                    "type": "object",
                    "description": "{ enabled, stopTicks, targetTicks, trailTicks }; distances in ticks."
                  },
                  "oco": {
                    "type": "object",
                    "description": "Optional entry peer. Both legs must rest; first fill cancels its peer."
                  }
                },
                "required": [
                  "symbol",
                  "side",
                  "type"
                ]
              },
              "example": {
                "symbol": "BTCUSDT",
                "side": "BUY",
                "type": "LIMIT",
                "quantity": 0.001,
                "price": 60000,
                "timeInForce": "GTC"
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "cancel_all",
        "tags": [
          "Trade"
        ],
        "summary": "Cancel entry orders",
        "description": "Cancel all working entry orders on this account. Position stop-loss and take-profit protection remains.",
        "security": [
          {
            "TradingToken": []
